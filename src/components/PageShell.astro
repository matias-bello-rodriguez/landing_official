---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
}

const { title, description, pageClass = "" } = Astro.props;
---

<Layout title={title} description={description} pageClass={pageClass}>
  <div class={`page page-tall page-ideas ${pageClass}`.trim()}>
    <div class="bg-waves" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </div>
  <script>
    import { initLazyVideos } from "../scripts/lazy-videos.js";
    initLazyVideos();
  </script>
  <slot name="scripts" />
</Layout>
